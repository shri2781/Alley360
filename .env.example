# Port 5433 avoids clashing with a local Postgres already on 5432.
DATABASE_URL=postgres://bowling:bowling@localhost:5433/bowling

# Signs the staff login session cookie. Any long random string -- e.g.
# `openssl rand -hex 32`. Changing it invalidates every existing session.
SESSION_SECRET=change-me-to-a-long-random-string

# The one shared staff login, created by `npm run db:seed` / `db:reset`.
# Change these before running against anything but your own machine, and
# change the password again from /staff/settings once you're in.
STAFF_USERNAME=staff
STAFF_PASSWORD=change-me
